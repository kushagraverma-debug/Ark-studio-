<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ARK Studio | Customised Stationery</title>
<meta name="description" content="ARK Studio - customised notebooks, registers, diaries, posters, stationery, book rentals, gift items and mystery stationery boxes.">
<style>
:root{
  --black:#101010;
  --gold:#f4bd18;
  --gold2:#ffd94b;
  --cream:#fffaf0;
  --paper:#fffdf7;
  --red:#e51d25;
  --muted:#5e5e5e;
  --shadow:0 12px 30px rgba(0,0,0,.12);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:Arial,Helvetica,sans-serif;
  color:var(--black);
  background:#f7f3e8;
  line-height:1.5;
}
a{text-decoration:none;color:inherit}
.container{width:min(1160px,92%);margin:auto}
nav{
  position:sticky;top:0;z-index:20;
  background:rgba(16,16,16,.96);color:white;
  box-shadow:0 4px 15px rgba(0,0,0,.2);
}
.nav-inner{min-height:68px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.logo{font-weight:1000;letter-spacing:1px;font-size:27px}
.logo span{color:var(--gold)}
.nav-links{display:flex;gap:25px;align-items:center}
.nav-links a{font-weight:700;font-size:14px}
.nav-links a:hover{color:var(--gold)}
.menu{display:none;background:none;border:0;color:#fff;font-size:27px}

.hero{
  min-height:650px;
  display:grid;place-items:center;
  background:
   radial-gradient(circle at 15% 20%,rgba(244,189,24,.25),transparent 28%),
   linear-gradient(135deg,#111 0%,#242424 58%,#101010 100%);
  color:#fff;position:relative;overflow:hidden;
}
.hero:after{
  content:"";position:absolute;width:420px;height:420px;border-radius:50%;
  right:-140px;top:-150px;background:rgba(244,189,24,.12);
}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:50px;align-items:center}
.kicker{color:var(--gold);font-weight:900;letter-spacing:3px;text-transform:uppercase}
h1{font-size:clamp(48px,7vw,88px);line-height:.9;margin:15px 0 20px;font-weight:1000}
h1 span{color:var(--gold)}
.tagline{font-size:21px;max-width:600px;color:#eee}
.hero-buttons{display:flex;gap:14px;flex-wrap:wrap;margin-top:30px}
.btn{
  display:inline-flex;align-items:center;justify-content:center;
  padding:13px 22px;border-radius:999px;font-weight:900;border:2px solid var(--gold);
  transition:.2s;cursor:pointer;
}
.btn.gold{background:var(--gold);color:#111}
.btn.dark{background:transparent;color:white}
.btn:hover{transform:translateY(-2px);box-shadow:0 8px 20px rgba(244,189,24,.2)}
.hero-card{
  background:#fff;color:#111;border-radius:26px;padding:30px;
  transform:rotate(2deg);box-shadow:0 25px 55px rgba(0,0,0,.4);
  border:8px solid #ece7d8;
}
.hero-card h2{font-size:34px;line-height:1;margin-bottom:12px}
.hero-card .yellow{color:#111;background:var(--gold);display:inline;padding:4px 9px}
.checks{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:20px}
.check{font-size:14px;font-weight:800}
.check b{color:var(--gold);font-size:20px}

section{padding:75px 0}
.section-head{text-align:center;margin-bottom:38px}
.section-head .eyebrow{color:#9a7600;font-weight:1000;text-transform:uppercase;letter-spacing:2px}
.section-head h2{font-size:42px;margin:7px 0}
.section-head p{color:var(--muted);max-width:680px;margin:auto}

.grid{display:grid;gap:20px}
.products{grid-template-columns:repeat(4,1fr)}
.card{
  background:var(--paper);border:1px solid #e8dfc8;border-radius:20px;
  padding:24px;box-shadow:var(--shadow);position:relative;overflow:hidden;
}
.card:before{content:"";position:absolute;top:0;left:0;width:100%;height:5px;background:var(--gold)}
.icon{font-size:38px;margin-bottom:10px}
.card h3{font-size:20px;margin-bottom:8px}
.price{font-size:23px;font-weight:1000;color:#111}
.card p{color:var(--muted);font-size:14px;margin:8px 0 16px}
.card .small-btn{display:inline-block;background:#111;color:#fff;padding:9px 14px;border-radius:10px;font-weight:800;font-size:13px}
.card .small-btn:hover{background:var(--gold);color:#111}

.split{display:grid;grid-template-columns:1fr 1fr;gap:25px}
.feature{
  background:#111;color:#fff;border-radius:25px;padding:35px;box-shadow:var(--shadow)
}
.feature.gold-bg{background:var(--gold);color:#111}
.feature h3{font-size:32px;margin-bottom:10px}
.feature .big{font-size:48px;font-weight:1000}
.feature ul{list-style:none;margin-top:20px}
.feature li{margin:9px 0;font-weight:700}
.feature li:before{content:"✓";color:var(--gold);margin-right:10px;font-weight:1000}
.gold-bg li:before{color:#111}

.stationery{grid-template-columns:repeat(3,1fr)}
.list{list-style:none}
.list li{padding:9px 0;border-bottom:1px dashed #ddd;display:flex;justify-content:space-between;gap:10px}
.list li:last-child{border:0}
.list strong{white-space:nowrap}

.combos{grid-template-columns:repeat(2,1fr)}
.combo{border-left:7px solid var(--gold)}
.combo h3{font-size:23px}
.combo .combo-price{font-size:28px;color:#d10e15;font-weight:1000;margin:5px 0 12px}

.mystery{background:#171717;color:white;border-radius:25px;padding:40px;box-shadow:var(--shadow)}
.mystery-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:18px;margin-top:25px}
.mystery-box{background:#222;border:1px solid #444;border-radius:18px;padding:25px;text-align:center}
.mystery-box .box{font-size:55px}
.mystery-box strong{display:block;font-size:28px;color:var(--gold)}

.contact{
  background:#111;color:white;text-align:center;padding:70px 0;
}
.contact h2{font-size:45px}
.phone{font-size:clamp(25px,5vw,45px);font-weight:1000;color:var(--gold);margin:18px 0}
.footer{background:#080808;color:#aaa;text-align:center;padding:22px;font-size:13px}

@media(max-width:900px){
  .hero-grid,.split{grid-template-columns:1fr}
  .hero{padding:80px 0}
  .hero-card{max-width:620px;margin:auto}
  .products{grid-template-columns:repeat(2,1fr)}
  .stationery{grid-template-columns:1fr}
}
@media(max-width:650px){
  .nav-links{display:none;position:absolute;top:68px;left:0;right:0;background:#111;padding:20px;flex-direction:column}
  .nav-links.open{display:flex}
  .menu{display:block}
  .products,.combos{grid-template-columns:1fr}
  section{padding:55px 0}
  .section-head h2{font-size:34px}
  h1{font-size:60px}
  .checks{grid-template-columns:1fr}
}

/* CART + CHECKOUT */
.cart-btn{
  position:relative;background:var(--gold);color:#111;border:0;
  padding:10px 16px;border-radius:999px;font-weight:1000;cursor:pointer;
}
.cart-count{
  position:absolute;right:-7px;top:-7px;background:#e51d25;color:#fff;
  min-width:21px;height:21px;border-radius:50%;display:grid;place-items:center;
  font-size:11px;border:2px solid #111;
}
.add-cart{
  border:0;background:#111;color:#fff;padding:10px 14px;border-radius:10px;
  font-weight:900;cursor:pointer;margin-top:10px;
}
.add-cart:hover{background:var(--gold);color:#111}
.drawer-overlay{
  display:none;position:fixed;inset:0;background:rgba(0,0,0,.58);z-index:100;
}
.drawer-overlay.show{display:block}
.cart-drawer{
  position:absolute;right:0;top:0;height:100%;width:min(460px,94vw);
  background:#fffdf7;padding:24px;overflow:auto;box-shadow:-10px 0 35px rgba(0,0,0,.3);
}
.drawer-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px}
.close-btn{border:0;background:#111;color:#fff;width:36px;height:36px;border-radius:50%;cursor:pointer;font-size:20px}
.cart-item{
  display:grid;grid-template-columns:1fr auto;gap:8px;padding:14px 0;
  border-bottom:1px dashed #ccc;
}
.cart-item h4{font-size:16px}
.cart-item small{color:#666}
.qty{display:flex;align-items:center;gap:8px;margin-top:7px}
.qty button{width:26px;height:26px;border:1px solid #aaa;background:#fff;border-radius:6px;cursor:pointer;font-weight:900}
.cart-total{display:flex;justify-content:space-between;font-size:22px;font-weight:1000;padding:18px 0}
.checkout{
  width:100%;border:0;background:var(--gold);color:#111;padding:14px;border-radius:12px;
  font-weight:1000;font-size:16px;cursor:pointer;
}
.empty{text-align:center;color:#777;padding:45px 10px}
.checkout-panel{display:none;margin-top:18px;border-top:2px solid #111;padding-top:18px}
.checkout-panel.show{display:block}
.checkout-panel label{display:block;font-weight:800;margin:11px 0 5px}
.checkout-panel input,.checkout-panel select,.checkout-panel textarea{
  width:100%;padding:11px;border:1px solid #bbb;border-radius:9px;font:inherit;background:#fff;
}
.payment-box{background:#fff3bd;padding:14px;border-radius:12px;margin-top:12px;font-size:14px}
.place-order{margin-top:15px;width:100%;background:#111;color:#fff;border:0;padding:14px;border-radius:12px;font-weight:1000;cursor:pointer}
.note{font-size:12px;color:#666;margin-top:8px}
@media(max-width:650px){
  .cart-btn{padding:9px 13px}
}

</style>
</head>
