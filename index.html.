<script>
const cart = JSON.parse(localStorage.getItem('arkCart') || '[]');

function saveCart(){
  localStorage.setItem('arkCart', JSON.stringify(cart));
  renderCart();
}
function addToCart(name, price){
  const existing = cart.find(i => i.name === name);
  if(existing) existing.qty++;
  else cart.push({name, price, qty:1});
  saveCart();
  openCart();
}
function changeQty(index, delta){
  cart[index].qty += delta;
  if(cart[index].qty <= 0) cart.splice(index,1);
  saveCart();
}
function removeItem(index){
  cart.splice(index,1);
  saveCart();
}
function cartTotal(){
  return cart.reduce((sum,i)=>sum + i.price*i.qty,0);
}
function renderCart(){
  const count = cart.reduce((sum,i)=>sum+i.qty,0);
  document.getElementById('cartCount').textContent = count;
  const items = document.getElementById('cartItems');
  const summary = document.getElementById('cartSummary');
  const checkout = document.getElementById('checkoutPanel');
  if(!cart.length){
    items.innerHTML = '<div class="empty">Your cart is empty.<br>Add something from ARK Studio! ✨</div>';
    summary.innerHTML = '';
    checkout.classList.remove('show');
    return;
  }
  items.innerHTML = cart.map((i,index)=>`
    <div class="cart-item">
      <div>
        <h4>${escapeHtml(i.name)}</h4>
        <small>₹${i.price} each</small>
        <div class="qty">
          <button onclick="changeQty(${index},-1)">−</button>
          <b>${i.qty}</b>
          <button onclick="changeQty(${index},1)">+</button>
          <button onclick="removeItem(${index})" title="Remove">🗑️</button>
        </div>
      </div>
      <b>₹${i.price*i.qty}</b>
    </div>`).join('');
  summary.innerHTML = `<div class="cart-total"><span>Total</span><span>₹${cartTotal()}</span></div>
    <button class="checkout" onclick="document.getElementById('checkoutPanel').classList.toggle('show')">Proceed to Checkout</button>`;
}
function openCart(){
  document.getElementById('cartOverlay').classList.add('show');
  renderCart();
}
function closeCart(){
  document.getElementById('cartOverlay').classList.remove('show');
}
function updatePaymentBox(){
  const method = document.getElementById('paymentMethod').value;
  document.getElementById('paymentBox').innerHTML = method === 'upi'
    ? `<b>UPI payment</b><br>After your merchant UPI ID is added, this section can open your UPI app with the exact order amount.
       <div class="note">For live online payments, replace YOUR-UPI-ID@BANK in the website code with your ARK Studio merchant UPI ID, or connect a payment gateway such as Razorpay.</div>`
    : `<b>Cash on Delivery / Pay on Delivery</b><br>Pay when your order is delivered.`;
}
function placeOrder(){
  const name = document.getElementById('customerName').value.trim();
  const phone = document.getElementById('customerPhone').value.trim();
  const address = document.getElementById('customerAddress').value.trim();
  const method = document.getElementById('paymentMethod').value;
  if(!name || !phone || !address){
    alert('Please enter your name, phone number and delivery address.');
    return;
  }
  if(!/^[0-9+\-\s]{10,15}$/.test(phone)){
    alert('Please enter a valid phone number.');
    return;
  }
  const orderLines = cart.map(i => `${i.name} x${i.qty} = ₹${i.price*i.qty}`).join('\\n');
  const msg = `Hi ARK Studio!%0A%0A*New Order*%0AName: ${encodeURIComponent(name)}%0APhone: ${encodeURIComponent(phone)}%0AAddress: ${encodeURIComponent(address)}%0A%0A${encodeURIComponent(orderLines)}%0A%0ATotal: ₹${cartTotal()}%0APayment: ${encodeURIComponent(method === 'upi' ? 'UPI / Online Payment' : 'Cash on Delivery')}`;
  window.open(`https://wa.me/919311517733?text=${msg}`, '_blank');
}
function escapeHtml(str){
  return str.replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[c]));
}
renderCart();
